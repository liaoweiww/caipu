[Unit]
Description=家庭私厨 Flask API
After=network.target mysql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/caipu/backend
ExecStart=/usr/bin/python3 -m gunicorn -c gunicorn_config.py api.server:app
Restart=always
RestartSec=5
StandardOutput=append:/var/log/caipu/gunicorn.log
StandardError=append:/var/log/caipu/gunicorn-error.log

Environment="CAIPU_DB_HOST=127.0.0.1"
Environment="CAIPU_DB_PORT=3306"
Environment="CAIPU_DB_USER=root"
Environment="CAIPU_DB_PASSWORD="
Environment="CAIPU_DB_NAME=caipu_app"
Environment="CAIPU_PORT=5000"

[Install]
WantedBy=multi-user.target
